{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "pcbkit",
            "tool": "view",
            "input": { "hook": "UserPromptSubmit" },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "pcbkit",
            "tool": "check",
            "input": { "changed": true, "path": "${tool_input.file_path}", "hook": "PostToolUse" },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "pcbkit",
            "tool": "check",
            "input": { "changed": true, "hook": "PostToolUse" },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
